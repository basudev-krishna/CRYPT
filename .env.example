# Copy to .env.local for local development. Never commit .env.local.
# Values below are the LOCAL Supabase defaults; keys come from `npx supabase status`.

# --- Runtime mode -------------------------------------------------------------
APP_ENV=development              # development | test | staging | production
DEMO_MODE=true                   # enables /api/dev/simulate-deposit (refused when APP_ENV=production)
# Must stay false. Any other value makes the web server and the worker refuse to start.
REAL_FUNDS_ENABLED=false

# --- Supabase (public; safe in the browser) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>

# --- Database (server only; never expose to the browser) -----------------------
# Least-privilege roles created by the migrations; local passwords set in supabase/seed.sql.
DATABASE_URL_WEB=postgres://app_web:app_web_local_dev_only@127.0.0.1:54322/postgres
DATABASE_URL_WORKER=postgres://app_worker:app_worker_local_dev_only@127.0.0.1:54322/postgres
# Superuser: used ONLY by integration/e2e tests and `npm run seed:demo` (local host enforced).
DATABASE_URL_ADMIN=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Service-to-service auth ---------------------------------------------------
# HMAC secret for /internal/* endpoints; at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=<random 64 hex chars>

# --- Integrations (all mocked/simulated in this build) --------------------------
CUSTODY_PROVIDER=simulated       # only "simulated" exists; anything else refuses to start payouts
SCREENING_BLOCKLIST=             # comma-separated addresses the mock screening provider flags as severe
SIM_PRICE_FEED_DOWN=false        # true simulates a price-feed outage (valuations fail safely)

# Optional testnet RPCs for the EVM adapter. Leave empty to keep those networks unavailable.
RPC_URL_EVM_SEPOLIA=
RPC_URL_EVM_ANVIL=
RPC_URL_BSC_TESTNET=

# --- Operations alerts (worker only) --------------------------------------------
# High/critical risk events are sent to this Telegram chat. Required for staging and production.
# Create a bot with @BotFather, add it to your ops group, then read the chat id from
#   https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Deployment ---------------------------------------------------------------
# Number of trusted reverse proxies that append to X-Forwarded-For (rate limiting / audit IPs).
TRUSTED_PROXY_HOPS=1

# --- Local tooling ------------------------------------------------------------
# DEMO_PASSWORD=                 # password for `npm run seed:demo` accounts (default Demo-Password-2026)
# E2E_PORT=3100                  # port Playwright starts `next start` on
